# Google Cloud Platform & API Credentials
GCP_PROJECT=your-gcp-project-id-here
GEMINI_API_KEY=your-gemini-api-key-here
# GITHUB_TOKEN=your-github-token-here (optional: increases GitHub REST rate limit from 60 to 5000 req/hr)

# Deployment Byte Safety Cap Toggle
# Set to 'true' for internal testing mode (enforces max bytes billed caps).
# Set to 'false' for production deployment (disables byte limits for end users).
ENABLE_BIGQUERY_BYTE_LIMITS=true
